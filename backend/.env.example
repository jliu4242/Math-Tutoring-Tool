SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
LLM_API_KEY=your-anthropic-api-key

# MinerU (ingestion/mineru_extraction.py) -- see backend/requirements-mineru.txt for
# the separate install step. These are mode switches, not secrets: unlike the vars
# above, leaving them unset is fine (mineru falls back to auto-detecting a model
# source, and to a plain "mineru" on PATH).
# MINERU_MODEL_SOURCE=huggingface   # huggingface | modelscope | local
# MINERU_CLI_PATH=mineru            # override if the mineru CLI isn't on this process's PATH
# MINERU_TIMEOUT_SECONDS=1800       # per-call subprocess timeout
